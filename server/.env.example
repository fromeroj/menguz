# ---- menguz-server configuration (copy to .env and adjust) ----

# Required in production: strong random secret for JWT signing
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap admin (password is generated and logged on first run if empty)
ADMIN_EMAIL=admin@menguz.local
ADMIN_PASS=

# ---- Aspel SAE 8.0 (Firebird) ----
# Leave SAE_HOST empty (or SAE_MOCK=true) to run with the demo catalog.
# Fill in to connect to the real SAE server (read-only user, VPN/IP whitelist).
SAE_HOST=
SAE_PORT=3050
SAE_USER=SYSDBA
SAE_PASS=
SAE_DB=C:\\Archivos Comunes\\Aspel\\SAE8.00\\Empresa01\\Datos\\Empresa01.fdb
SAE_MOCK=true
SYNC_AT=03:00

# ---- Data paths ----
BADGER_PATH=./data/badger
SQLITE_PATH=./data/analytics.db
DATA_DIR=./data
STATIC_DIR=../design/app/dist

# ---- Bank transfer (B2C checkout reference) ----
BANK_NAME=BBVA
BANK_CLABE=000000000000000000
BANK_HOLDER=Menguz Vinos y Licores SA de CV

# ---- WhatsApp Business API (Meta) ----
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_ID=

# ---- OpenAI chatbot (empty → deterministic fallback engine) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- HTTP ----
PORT=8080
# CORS_ORIGINS=https://menguz.mx,https://www.menguz.mx
